{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "preservation-billing-sync": {
      "schedule": "15 * * * *",
      "timezone": "America/New_York",
      "path": "/api/preservation/billing-sync",
      "requestMethod": "GET",
      "jitter": 5
    },
    "preservation-provision-retry": {
      "schedule": "*/10 * * * *",
      "timezone": "America/New_York",
      "path": "/api/preservation/provision-retry",
      "requestMethod": "GET",
      "jitter": 2
    }
  }
}
